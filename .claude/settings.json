{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(bash scripts/evidence.sh run:*)",
      "Bash(bash scripts/evidence.sh status:*)",
      "Bash(bash scripts/evidence.sh show:*)",
      "Bash(bash scripts/evidence.sh start:*)",
      "Bash(bash scripts/evidence.sh done:*)",
      "Bash(bash scripts/evidence.sh close:*)",
      "Bash(bash scripts/evidence.sh lint:*)",
      "Bash(bash scripts/task-pair.sh check:*)",
      "Bash(bash scripts/task-pair.sh wait:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf ../*)",
      "Bash(bash scripts/evidence.sh trust:*)",
      "Bash(bash scripts/evidence.sh approve:*)",
      "Bash(bash scripts/evidence.sh check:*)",
      "Edit(./scripts/evidence.sh)",
      "Edit(./scripts/precommit-gitleaks.sh)",
      "Edit(./scripts/harness-report.sh)",
      "Edit(./.claude/hooks/guard-patterns.sh)",
      "Edit(./.claude/hooks/stop-gate.sh)",
      "Edit(./.claude/hooks/spawn-log.sh)",
      "Edit(./.claude/settings.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./.secrets/**)",
      "Read(./**/.secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(./.ai_context/tasks/**/gatelog)",
      "Edit(./.ai_context/tasks/**/spawnlog)",
      "Edit(./.ai_context/tasks/**/donelog)",
      "Edit(./.claude/evidence/**)",
      "Edit(./.claude/done-lanes.trust)",
      "Edit(./.claude/gitleaks.toml)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "executor",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/spawn-log.sh\" executor start"
          }
        ]
      },
      {
        "matcher": "checker",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/spawn-log.sh\" checker start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "executor",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/spawn-log.sh\" executor stop"
          }
        ]
      },
      {
        "matcher": "checker",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/spawn-log.sh\" checker stop",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
